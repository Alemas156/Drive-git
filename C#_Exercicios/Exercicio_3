using System;
public class Program
{
   static void Main()
 {
   Console.WriteLine("Escreva uma nota: ");
   int nota = int.Parse(Console.ReadLine());
   
   if (nota >= 7)
   {
       Console.WriteLine("Aprovado");
   }
   else if (nota >= 5)
   {
       Console.WriteLine("Recuperação");
   }
   else
   {
       Console.WriteLine("Reprovado");
   }
   
   
 }
}
